{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Local main window: document commands and event subscription only",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-take-pending-markdown-files",
    "allow-read-markdown-file",
    "allow-write-markdown-file",
    "allow-close-markdown-file",
    "allow-read-document-images",
    "allow-pick-markdown-files",
    "allow-save-export-file"
  ]
}
