{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Mark_md",
  "version": "0.1.0",
  "identifier": "kr.gqai.markmd",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3006",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Mark_md",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "A local Markdown viewer and editor",
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown document",
        "role": "Editor",
        "mimeType": "text/markdown",
        "rank": "Owner",
        "exportedType": {
          "identifier": "kr.gqai.markmd.document",
          "conformsTo": ["public.plain-text"]
        }
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
